# Only NEXT_PUBLIC_* values. No secrets belong in this app.

# Public site address (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://arpedia.africa

# api Worker base URL. /legal/<slug> reads the published policy text from its public /legal pages.
# Leave empty to show only the bundled text.
NEXT_PUBLIC_API_URL=https://api.arpedia.africa

# App Store listing. Leave empty until the iOS app is live; the badge stays hidden.
NEXT_PUBLIC_APP_STORE_URL=
