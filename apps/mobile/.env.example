# Copy to .env.local. Local values come from `pnpm exec supabase status` (API_URL, ANON_KEY).
# On the Android emulator, 10.0.2.2 reaches the host machine.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# Optional locally; set in CI/staging builds.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Google Play purchases (RevenueCat public Android SDK key, goog_...). Empty: the store is unavailable.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
