{
  "expo": {
    "name": "Arpedia",
    "slug": "arpedia",
    "scheme": "arpedia",
    "version": "26.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "africa.arpedia.reader",
      "supportsTablet": false,
      "associatedDomains": ["applinks:arpedia.africa", "applinks:www.arpedia.africa"]
    },
    "android": {
      "package": "com.arpedia.reader",
      "versionCode": 26,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "arpedia.africa",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "arpedia.africa",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "arpedia.africa",
              "pathPrefix": "/book/"
            },
            {
              "scheme": "https",
              "host": "arpedia.africa",
              "pathPrefix": "/author/"
            },
            {
              "scheme": "https",
              "host": "arpedia.africa",
              "pathPrefix": "/community/"
            },
            {
              "scheme": "https",
              "host": "arpedia.africa",
              "path": "/account"
            },
            {
              "scheme": "https",
              "host": "www.arpedia.africa",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "www.arpedia.africa",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "www.arpedia.africa",
              "pathPrefix": "/book/"
            },
            {
              "scheme": "https",
              "host": "www.arpedia.africa",
              "pathPrefix": "/author/"
            },
            {
              "scheme": "https",
              "host": "www.arpedia.africa",
              "pathPrefix": "/community/"
            },
            {
              "scheme": "https",
              "host": "www.arpedia.africa",
              "path": "/account"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "./plugins/staging-variant",
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/dev-variant",
      "./plugins/kit-localhost",
      "./plugins/v25-cleanup",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F5931F"
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/google-services"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
