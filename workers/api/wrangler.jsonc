// Arpedia API Worker. Top level = local (`wrangler dev`); env.staging and env.production deploy.
// Secrets (never in this file): SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY, BOOK_MASTER_KEY,
// UPLOAD_SIGNING_KEY. Local only, in .dev.vars (pnpm dev:vars): those plus SUPABASE_JWT_SECRET.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arpedia-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Book pipeline safety net: retries verify/seal messages that waitUntil did not finish (flow 12).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ENV": "local",
    "SUPABASE_URL": "http://127.0.0.1:55321",
  },
  "r2_buckets": [{ "binding": "BOOKS", "bucket_name": "arpedia-books-local" }],
  // Flow 04: /keys and /download, 60 a minute per reader and device. Not inherited: repeated per env.
  "ratelimits": [{ "name": "KEYS_LIMIT", "namespace_id": "4001", "simple": { "limit": 60, "period": 60 } }],
  // Paid author messages (flow 08) and room progress events (flow 07) go out through the chat Worker's conversation Durable Object.
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION", "class_name": "ConversationDO", "script_name": "arpedia-chat" },
      { "name": "CHAT_ROOMS", "class_name": "ConversationDO", "script_name": "arpedia-chat" },
    ],
  },
  "env": {
    "staging": {
      "name": "arpedia-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "SUPABASE_URL": "https://wsblzfpiflefqpbsqkuy.supabase.co",
      },
      // Not inherited from the top level: without this the deployed Worker has no cron.
      "triggers": { "crons": ["* * * * *"] },
      "r2_buckets": [{ "binding": "BOOKS", "bucket_name": "arpedia-books-staging" }],
      "ratelimits": [
        { "name": "KEYS_LIMIT", "namespace_id": "4001", "simple": { "limit": 60, "period": 60 } },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATION", "class_name": "ConversationDO", "script_name": "arpedia-chat-staging" },
          { "name": "CHAT_ROOMS", "class_name": "ConversationDO", "script_name": "arpedia-chat-staging" },
        ],
      },
    },
    "production": {
      "name": "arpedia-api",
      "vars": {
        "APP_ENV": "production",
        "SUPABASE_URL": "https://lzrctrkuvkeftujqiqbn.supabase.co",
        // Links in emails (verify email) and saved avatar URLs.
        "PUBLIC_API_URL": "https://api.arpedia.africa",
      },
      "triggers": { "crons": ["* * * * *"] },
      "r2_buckets": [{ "binding": "BOOKS", "bucket_name": "arpedia-books-prod" }],
      "ratelimits": [
        { "name": "KEYS_LIMIT", "namespace_id": "4001", "simple": { "limit": 60, "period": 60 } },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATION", "class_name": "ConversationDO", "script_name": "arpedia-chat" },
          { "name": "CHAT_ROOMS", "class_name": "ConversationDO", "script_name": "arpedia-chat" },
        ],
      },
    },
  },
}
