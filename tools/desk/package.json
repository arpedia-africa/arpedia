{
  "name": "@arpedia/desk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Staff desk CLI: pulls book_desk jobs, converts with pandoc or poppler, runs epubcheck (flow 12)",
  "main": "./src/index.ts",
  "bin": {
    "desk": "./bin/desk.mjs"
  },
  "scripts": {
    "desk": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@arpedia/convert": "workspace:*",
    "@arpedia/core": "workspace:*",
    "domhandler": "^5.0.3",
    "htmlparser2": "^10.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
