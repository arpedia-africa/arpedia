{
  "name": "arpedia",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@arpedia/admin --filter=@arpedia/api --filter=@arpedia/chat",
    "dev:mobile": "pnpm --filter @arpedia/mobile start",
    "dev:admin": "pnpm --filter @arpedia/admin dev",
    "dev:workers": "turbo run dev --parallel --filter=@arpedia/api --filter=@arpedia/chat",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "gen:types": "supabase gen types typescript >packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
